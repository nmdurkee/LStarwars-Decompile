state Base {
	ReferenceScript {
		Script=GeneralParty
		Source=Global
		ReturnState=Base
		Conditions {
			if InTriggerArea "Bonus_Area" == 0
		}
	}
	Conditions {
		if PlayerToLocator "pod_lift2" < 0.2 goto pod_lift1
		if HelpWithTriggers == 1 goto HelpWithTriggers
	}
	Actions {	
		FollowPlayer "1"
	}
}

state pod_lift1 {
	Conditions {
		if PlayerToLocator "pod_lift2" > 0.25 goto Base
	}
	Actions {	
		GoToLocator "name" "pod_lift1" 
	}
}

state HelpWithTriggers {
	Conditions {
		if HelpWithTriggers == 0 goto Base
	}
	Actions {	
		HelpWithTriggers
	}
}